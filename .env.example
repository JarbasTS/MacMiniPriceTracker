POSTGRES_USER=mactracker
# Em produção: gere com `openssl rand -hex 24` (hex evita @ / : que quebram a DATABASE_URL)
POSTGRES_PASSWORD=mactracker_secret
POSTGRES_DB=mactracker_db
# Usada só pelo cargo fora do Docker; no compose o backend recebe a URL com host `postgres`
DATABASE_URL=postgres://mactracker:mactracker_secret@localhost:5432/mactracker_db
RUST_LOG=info,mac_mini_tracker_backend=debug
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# --- Deploy (ver docs/deploy.md) ---
# Portas publicadas em 127.0.0.1 no host. Vazias = 5432 / 8080 / 3000.
# Numa VM compartilhada com outro app (que já usa 5432 e 3000): 5433 / 8080 / 3100.
POSTGRES_HOST_PORT=
BACKEND_HOST_PORT=
FRONTEND_HOST_PORT=
# URL da API vista pelo browser, fixada no build do frontend. Atrás do Cloudflare Tunnel: /api
PUBLIC_API_URL=
# Token do túnel (Zero Trust → Networks → Tunnels → Docker)
TUNNEL_TOKEN=

# Mercado Livre (app em developers.mercadolivre.com.br). O refresh token só semeia o banco na 1ª vez; depois vive em oauth_tokens.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=
